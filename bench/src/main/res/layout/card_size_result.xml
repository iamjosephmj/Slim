<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/surface_subtle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: size + bytes + status chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sizeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sizeBytes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:alpha="0.55"
                    android:typeface="monospace"
                    android:paddingTop="1dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textAllCaps="true" />
        </LinearLayout>

        <!-- JNI row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="20dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="JNI"
                android:textColor="@color/jni_color"
                android:textStyle="bold"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/jniBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:max="1000"
                android:progressDrawable="@drawable/bar_track" />

            <TextView
                android:id="@+id/jniTime"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:textAlignment="textEnd"
                android:typeface="monospace"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/jniDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="textEnd"
            android:typeface="monospace"
            android:textSize="11sp"
            android:alpha="0.55"
            android:paddingTop="4dp" />

        <!-- Slim row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="14dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="Slim"
                android:textColor="@color/slim_color"
                android:textStyle="bold"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/slimBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:max="1000"
                android:progressDrawable="@drawable/bar_track" />

            <TextView
                android:id="@+id/slimTime"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:textAlignment="textEnd"
                android:typeface="monospace"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/slimDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="textEnd"
            android:typeface="monospace"
            android:textSize="11sp"
            android:alpha="0.55"
            android:paddingTop="4dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
