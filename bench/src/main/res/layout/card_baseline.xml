<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/surface_subtle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DISPATCH BASELINE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:textColor="@color/chip_neutral" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Empty kernel · pure call overhead"
            android:textSize="13sp"
            android:alpha="0.6"
            android:paddingTop="2dp"
            android:paddingBottom="14dp" />

        <!-- JNI row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="JNI"
                android:textColor="@color/jni_color"
                android:textStyle="bold"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/jniBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:max="1000"
                android:progressDrawable="@drawable/bar_track" />

            <TextView
                android:id="@+id/jniValue"
                android:layout_width="84dp"
                android:layout_height="wrap_content"
                android:textAlignment="textEnd"
                android:typeface="monospace"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Slim row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="Slim"
                android:textColor="@color/slim_color"
                android:textStyle="bold"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/slimBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:max="1000"
                android:progressDrawable="@drawable/bar_track" />

            <TextView
                android:id="@+id/slimValue"
                android:layout_width="84dp"
                android:layout_height="wrap_content"
                android:textAlignment="textEnd"
                android:typeface="monospace"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:background="#1AFFFFFF" />

        <TextView
            android:id="@+id/deltaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textAlignment="center"
            android:alpha="0.85" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
